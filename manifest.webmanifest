{
  "name": "Anvil",
  "short_name": "Anvil",
  "description": "A MODDYS Foundry instrument — acid, wavetable, FM, string, drum, granular and sampler engines in one local-first browser synth.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#16140f",
  "theme_color": "#16140f",
  "categories": [
    "music",
    "entertainment"
  ],
  "icons": [
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "application/x-anvil-project": [
          ".anvl"
        ],
        "audio/wav": [
          ".wav"
        ],
        "audio/mpeg": [
          ".mp3"
        ],
        "audio/midi": [
          ".mid"
        ],
        "application/zip": [
          ".zip"
        ]
      }
    }
  ]
}
