   Probe script (in-page, async IIFE):
   -------------------------------------------------------------------------------------------
   const sr = 48000, total = sr * 2;
   const oc = new OfflineAudioContext(2, total, sr);
   const h = await avEngineBoot(oc, { offline: true });
   oc.suspend(0.5).then(() => { a.ct1 = oc.currentTime; a.on1 = (h.noteOn(60, 0.9) === true); oc.resume(); });
   oc.suspend(1.0).then(() => { a.ct2 = oc.currentTime; h.noteOff(60); oc.resume(); });
   for (let k = 0; k < 6; k++) { const t = 1.2 + 0.05*k;
     oc.suspend(t).then(() => { if (k%2===0) h.noteOn(64,0.9); else h.noteOff(64); oc.resume(); }); }
   const buf = await oc.startRendering();   // 2 s stereo
   // windows: pre 0.10-0.45 s · held 0.60-0.95 s · post 1.50-1.95 s ; onset = first |x| > 1e-4
